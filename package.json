{
  "name": "@bvandrc/react-toolkit",
  "version": "2.5.0",
  "description": "Generic React hooks and helpers for UI behavior, such as press-and-hold, scrolling into view, the visual viewport and on-screen keyboard, focus handoff and return, and more.",
  "keywords": [
    "react",
    "hooks",
    "visual-viewport",
    "virtual-keyboard",
    "mobile",
    "focus",
    "long-press",
    "scroll-into-view",
    "popover"
  ],
  "author": "Blake Vandercar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bvandrc/react-toolkit.git"
  },
  "homepage": "https://github.com/bvandrc/react-toolkit#readme",
  "bugs": "https://github.com/bvandrc/react-toolkit/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./active-tab": {
      "types": "./dist/active-tab.d.mts",
      "default": "./dist/active-tab.mjs"
    },
    "./gestures": {
      "types": "./dist/gestures/index.d.mts",
      "default": "./dist/gestures/index.mjs"
    },
    "./test-support": {
      "types": "./dist/test-support/index.d.mts",
      "default": "./dist/test-support/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "__c0": "====================[ Build & Development ]======================",
    "prepublishOnly": "pnpm run check && pnpm run test && pnpm run build",
    "build": "tsdown",
    "__c1": "====================[ Linting & Type Checking ]==================",
    "check": "pnpm run ts:check && pnpm run lint",
    "format": "biome check . --fix",
    "lint": "biome check .",
    "ts:check": "tsc",
    "__c2": "====================[ Unit Testing ]=============================",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:isolated": "vitest run --isolate"
  },
  "dependencies": {
    "es-toolkit": "^1",
    "type-fest": "^5",
    "usehooks-ts": "^3"
  },
  "peerDependencies": {
    "@testing-library/react": "^16",
    "@use-gesture/react": "^10",
    "react": "^18 || ^19",
    "tab-election": "^4",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "@testing-library/react": {
      "optional": true,
      "description": "For `./test-support`'s Vitest mocks, which render through it."
    },
    "@use-gesture/react": {
      "optional": true,
      "description": "For `./gestures`, whose hooks are built on it."
    },
    "tab-election": {
      "optional": true,
      "description": "For `./active-tab`, which runs its election."
    },
    "vitest": {
      "optional": true,
      "description": "For `./test-support`, whose mocks are Vitest's."
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^24",
    "@types/react": "^18",
    "@use-gesture/react": "^10",
    "@vitejs/plugin-react": "^6",
    "happy-dom": "^21",
    "react": "^18",
    "react-dom": "^18",
    "tab-election": "^4",
    "tailwindcss": "^4",
    "ts-extras": "^1",
    "tsdown": "^0.23",
    "typescript": "^7",
    "vitest": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.15.0"
}
